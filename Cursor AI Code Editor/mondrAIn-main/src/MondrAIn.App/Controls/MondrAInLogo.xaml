<UserControl x:Class="MondrAIn.App.Controls.MondrAInLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Mondrian.Black" Color="#1A1A1A" />
        <SolidColorBrush x:Key="Mondrian.White" Color="#FBFBF6" />
        <SolidColorBrush x:Key="Mondrian.Red" Color="#D7263D" />
        <SolidColorBrush x:Key="Mondrian.Blue" Color="#1B3B8B" />
        <SolidColorBrush x:Key="Mondrian.Yellow" Color="#F5C518" />
    </UserControl.Resources>

    <!-- Scales crisply to whatever height the host gives it -->
    <Viewbox Stretch="Uniform"
             HorizontalAlignment="Left">
        <!-- Design canvas: 560 x 132 -->
        <Grid Width="560"
              Height="132">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Mondrian logo mark: 132 x 132 composition on a black grid -->
            <Border Grid.Column="0"
                    Width="132"
                    Height="132"
                    Background="{StaticResource Mondrian.Black}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="3"
                                      Opacity="0.25"
                                      Color="#1A1A1A" />
                </Border.Effect>
                <Canvas>
                    <!-- Cells are inset by ~6px from each edge/line so the black
                         background reads as classic Mondrian gridlines. -->

                    <!-- A: large red block (top-left) -->
                    <Rectangle Canvas.Left="6"  Canvas.Top="6"
                               Width="60"  Height="66"
                               Fill="{StaticResource Mondrian.Red}" />

                    <!-- B1: blue block (top-right) -->
                    <Rectangle Canvas.Left="72" Canvas.Top="6"
                               Width="54"  Height="30"
                               Fill="{StaticResource Mondrian.Blue}" />

                    <!-- B2: white block (mid-right) -->
                    <Rectangle Canvas.Left="72" Canvas.Top="42"
                               Width="54"  Height="30"
                               Fill="{StaticResource Mondrian.White}" />

                    <!-- C: yellow block (bottom-left) -->
                    <Rectangle Canvas.Left="6"  Canvas.Top="78"
                               Width="60"  Height="48"
                               Fill="{StaticResource Mondrian.Yellow}" />

                    <!-- D: white block (bottom-right) -->
                    <Rectangle Canvas.Left="72" Canvas.Top="78"
                               Width="54"  Height="48"
                               Fill="{StaticResource Mondrian.White}" />
                </Canvas>
            </Border>

            <!-- Wordmark -->
            <StackPanel Grid.Column="1"
                        Margin="22,0,0,0"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="mondr"
                               FontFamily="Segoe UI"
                               FontWeight="Black"
                               FontSize="64"
                               Foreground="{StaticResource Mondrian.Black}" />

                    <!-- "A" set into a red Mondrian tile -->
                    <Border Background="{StaticResource Mondrian.Red}"
                            Margin="4,0,0,0"
                            Padding="10,2,10,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="A"
                                   FontFamily="Segoe UI"
                                   FontWeight="Black"
                                   FontSize="50"
                                   Foreground="{StaticResource Mondrian.White}" />
                    </Border>

                    <!-- "I" set into a blue Mondrian tile -->
                    <Border Background="{StaticResource Mondrian.Blue}"
                            Margin="4,0,0,0"
                            Padding="10,2,10,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="I"
                                   FontFamily="Segoe UI"
                                   FontWeight="Black"
                                   FontSize="50"
                                   Foreground="{StaticResource Mondrian.White}" />
                    </Border>

                    <TextBlock Text="n"
                               Margin="4,0,0,0"
                               FontFamily="Segoe UI"
                               FontWeight="Black"
                               FontSize="64"
                               Foreground="{StaticResource Mondrian.Black}" />
                </StackPanel>

                <!-- Tagline with a thin Mondrian rule above it -->
                <Rectangle Height="4"
                           Margin="2,6,0,0"
                           HorizontalAlignment="Stretch"
                           Fill="{StaticResource Mondrian.Black}" />
                <TextBlock Text="one image  ·  many views"
                           Margin="3,5,0,0"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#666666"
                           TextOptions.TextFormattingMode="Ideal" />
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>
