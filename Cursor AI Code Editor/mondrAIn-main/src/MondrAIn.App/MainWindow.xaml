<Window x:Class="MondrAIn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MondrAIn.App.Controls"
        mc:Ignorable="d"
        Title="mondrAIn"
        Icon="pack://application:,,,/Assets/mondrAIn.ico"
        MinHeight="480"
        MinWidth="640"
        Height="720"
        Width="1024"
        Background="#FBFBF6">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Artsy Mondrian-inspired logo header -->
        <controls:MondrAInLogo Grid.Row="0"
                               Height="76"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,20" />

        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Padding="16,8"
                        Content="Upload Image"
                        Command="{Binding UploadImageCommand}" />
                <Button Margin="12,0,0,0"
                        Padding="16,8"
                        Content="Grayscale"
                        Command="{Binding ApplyGrayscaleCommand}"
                        IsEnabled="{Binding HasSourceImage}" />
                <Button Margin="12,0,0,0"
                        Padding="16,8"
                        Content="ASCII"
                        Command="{Binding ApplyAsciiCommand}"
                        IsEnabled="{Binding HasSourceImage}" />
                <Button Margin="12,0,0,0"
                        Padding="16,8"
                        Content="Flip Horizontally"
                        Command="{Binding ApplyFlipHorizontalCommand}"
                        IsEnabled="{Binding HasSourceImage}" />
                <Button Margin="12,0,0,0"
                        Padding="16,8"
                        Content="Flip Vertically"
                        Command="{Binding ApplyFlipVerticalCommand}"
                        IsEnabled="{Binding HasSourceImage}" />
            </StackPanel>
            <Button Padding="16,8"
                    HorizontalAlignment="Right"
                    Content="Revert"
                    Command="{Binding RevertCommand}" />
        </Grid>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                BorderBrush="#33000000"
                BorderThickness="1">
            <Grid>
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
